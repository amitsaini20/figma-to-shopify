{%- capture icon_arrow -%}
  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8h11M9.5 4l4 4-4 4"/></svg>
{%- endcapture -%}

{%- capture icon_wa -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.2 20.8l1.5-4.6A9 9 0 1 1 8 19.5l-4.8 1.3z"/><path d="M9 8.3c.2 2.7 3.1 5.6 5.8 5.8l1.3-1.4-2.1-1-.9.8c-1-.4-2-1.4-2.4-2.4l.8-.9-1-2.1L9 8.3z"/></svg>
{%- endcapture -%}

<style>
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.body_font | font_face: font_display: 'swap' }}

  #Cta-{{ section.id }} {
    --cta-bg: {{ section.settings.background_color }};
    --cta-heading: {{ section.settings.heading_color }};
    --cta-btn-bg: {{ section.settings.button_bg }};
    --cta-btn-icon-bg: {{ section.settings.button_icon_bg }};
    --cta-btn-text: {{ section.settings.button_text_color }};
    --cta-link: {{ section.settings.link_color }};
    --cta-muted: {{ section.settings.muted_color }};
    --cta-pt: {{ section.settings.desktop_padding_top }}px;
    --cta-pb: {{ section.settings.desktop_padding_bottom }}px;
    --cta-h-size: {{ section.settings.desktop_heading_size }}px;
    --cta-h-width: {{ section.settings.desktop_heading_width }}px;
    --cta-h-space: {{ section.settings.desktop_heading_space }}px;
    --cta-btn-h: {{ section.settings.desktop_button_height }}px;
    --cta-btn-px: {{ section.settings.desktop_button_padding }}px;
    --cta-btn-size: {{ section.settings.desktop_button_font_size }}px;
    --cta-btn-width: auto;
    --cta-sub-size: {{ section.settings.desktop_sub_size }}px;
    --cta-sub-space: {{ section.settings.desktop_sub_space }}px;
        --cta-sh-size: {{ section.settings.desktop_sh_size }}px;
    --cta-sh-width: {{ section.settings.desktop_sh_width }}px;
    --cta-sh-gap: {{ section.settings.sh_gap }}px;
    --cta-sh-color: {{ section.settings.sh_color }};

    background: var(--cta-bg);
    padding: var(--cta-pt) 20px var(--cta-pb);
    text-align: center;
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
  }

  #Cta-{{ section.id }} .cta__inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
  }

  #Cta-{{ section.id }} .cta__heading {
    max-width: var(--cta-h-width);
    margin: 0 auto var(--cta-h-space);
    color: var(--cta-heading);
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font.weight }};
    font-size: var(--cta-h-size);
    line-height: 1.25;
    letter-spacing: 0.04em;
  }

    #Cta-{{ section.id }} .cta__heading--has-sh {
    margin-bottom: var(--cta-sh-gap);
  }

  #Cta-{{ section.id }} .cta__subheading {
    max-width: var(--cta-sh-width);
    margin: 0 auto var(--cta-h-space);
    color: var(--cta-sh-color);
    font-size: var(--cta-sh-size);
    letter-spacing: 0.06em;
    line-height: 1.6;
  }

  #Cta-{{ section.id }} .cta__btn {
    display: inline-flex;
    align-items: stretch;
    width: var(--cta-btn-width);
    height: var(--cta-btn-h);
    background: var(--cta-btn-bg);
    color: var(--cta-btn-text);
    border: 1px solid {{ section.settings.button_border_color }};
    text-decoration: none;
    font-size: var(--cta-btn-size);
    letter-spacing: 0.08em;
    transition: opacity 0.2s;
  }

  #Cta-{{ section.id }} .cta__btn:hover {
    opacity: 0.9;
  }

  #Cta-{{ section.id }} .cta__btn-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 var(--cta-btn-h);
    background: var(--cta-btn-icon-bg);
  }

  #Cta-{{ section.id }} .cta__btn-icon svg {
    width: 14px;
    height: 14px;
  }

  #Cta-{{ section.id }} .cta__btn-label {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    padding: 0 var(--cta-btn-px);
    white-space: nowrap;
  }

  #Cta-{{ section.id }} .cta__sub {
    margin: var(--cta-sub-space) 0 0;
    color: var(--cta-muted);
    font-size: var(--cta-sub-size);
    letter-spacing: 0.08em;
    display: flex;
    justify-content: center;
    gap: 6px;
  }

  #Cta-{{ section.id }} .cta__sub a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--cta-link);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #Cta-{{ section.id }} .cta__sub svg {
    width: 1.15em;
    height: 1.15em;
    flex-shrink: 0;
  }

  #Cta-{{ section.id }} .cta__sub--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #Cta-{{ section.id }} {
      --cta-pt: {{ section.settings.mobile_padding_top }}px;
      --cta-pb: {{ section.settings.mobile_padding_bottom }}px;
      --cta-h-size: {{ section.settings.mobile_heading_size }}px;
      --cta-h-width: {{ section.settings.mobile_heading_width }}px;
      --cta-h-space: {{ section.settings.mobile_heading_space }}px;
      --cta-btn-h: {{ section.settings.mobile_button_height }}px;
      --cta-btn-size: {{ section.settings.mobile_button_font_size }}px;
      --cta-sub-size: {{ section.settings.mobile_sub_size }}px;
      --cta-sub-space: {{ section.settings.mobile_sub_space }}px;
            --cta-sh-size: {{ section.settings.mobile_sh_size }}px;
      --cta-sh-width: 100%;
      {% if section.settings.mobile_button_full %}
        --cta-btn-width: 100%;
      {% endif %}
    }

    #Cta-{{ section.id }} .cta__sub--desktop { display: none; }
    #Cta-{{ section.id }} .cta__sub--mobile { 
        display: flex;
        jusify-content: center;
    }
  }
</style>

<section id="Cta-{{ section.id }}" class="cta">
  <div class="cta__inner">
       {% if section.settings.heading != blank %}
      <h2 class="cta__heading{% if section.settings.subheading != blank %} cta__heading--has-sh{% endif %}">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="cta__subheading">{{ section.settings.subheading | escape | newline_to_br }}</p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a class="cta__btn" href="{{ section.settings.button_link | default: '#' }}">
        <span class="cta__btn-icon">{{ icon_arrow }}</span>
        <span class="cta__btn-label">{{ section.settings.button_label | escape }}</span>
      </a>
    {% endif %}

    {% if section.settings.desktop_link_label != blank %}
      <p class="cta__sub cta__sub--desktop">
        {{ section.settings.desktop_prefix | escape }}
        <a href="{{ section.settings.desktop_link_url | default: '#' }}">
          {%- if section.settings.desktop_icon == 'arrow' %}{{ icon_arrow }}{% elsif section.settings.desktop_icon == 'whatsapp' %}{{ icon_wa }}{% endif -%}
          {{ section.settings.desktop_link_label | escape }}
        </a>
        {{ section.settings.desktop_suffix | escape }}
      </p>
    {% endif %}

    {% if section.settings.mobile_link_label != blank %}
      <p class="cta__sub cta__sub--mobile">
        {{ section.settings.mobile_prefix | escape }}
        <a href="{{ section.settings.mobile_link_url | default: '#' }}">
          {%- if section.settings.mobile_icon == 'arrow' %}{{ icon_arrow }}{% elsif section.settings.mobile_icon == 'whatsapp' %}{{ icon_wa }}{% endif -%}
          {{ section.settings.mobile_link_label | escape }}
        </a>
        {{ section.settings.mobile_suffix | escape }}
      </p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Anfrage CTA",
  "tag": "div",
  "class": "section-anfrage-cta",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sie haben Ihre eigene Idee? Wir setzen sie um."
    },
        {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Wir beraten Sie persönlich und erstellen Ihnen ein individuelles Angebot."
    },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Unverbindliche Anfrage stellen" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Second line - Desktop" },
    { "type": "text", "id": "desktop_prefix", "label": "Text before link", "default": "oder" },
    {
      "type": "select",
      "id": "desktop_icon",
      "label": "Icon before link",
      "default": "arrow",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "arrow", "label": "Arrow" },
        { "value": "whatsapp", "label": "WhatsApp" }
      ]
    },
    { "type": "text", "id": "desktop_link_label", "label": "Link text", "default": "Termin vor Ort" },
    { "type": "text", "id": "desktop_suffix", "label": "Text after link", "default": "vereinbaren" },
    { "type": "url", "id": "desktop_link_url", "label": "Link" },

    { "type": "header", "content": "Second line - Mobile" },
    { "type": "text", "id": "mobile_prefix", "label": "Text before link", "default": "Oder direkt per" },
    {
      "type": "select",
      "id": "mobile_icon",
      "label": "Icon before link",
      "default": "whatsapp",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "arrow", "label": "Arrow" },
        { "value": "whatsapp", "label": "WhatsApp" }
      ]
    },
    { "type": "text", "id": "mobile_link_label", "label": "Link text", "default": "WhatsApp schreiben" },
    { "type": "text", "id": "mobile_suffix", "label": "Text after link" },
    { "type": "url", "id": "mobile_link_url", "label": "Link" },

    { "type": "header", "content": "Fonts" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "playfair_display_n4" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#EAE6E1" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#2B2623" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#4D5A47" },
    { "type": "color", "id": "button_icon_bg", "label": "Button icon box", "default": "#66745F" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" },
    { "type": "color", "id": "button_border_color", "label": "Button border", "default": "#3F4A3A" },
    { "type": "color", "id": "muted_color", "label": "Second line text", "default": "#6F6862" },
    { "type": "color", "id": "link_color", "label": "Second line link", "default": "#1E1B19" },
        { "type": "color", "id": "sh_color", "label": "Subheading", "default": "#6F6862" },

    { "type": "header", "content": "Desktop layout" },
    { "type": "range", "id": "content_max_width", "label": "Content max width", "min": 400, "max": 1400, "step": 20, "unit": "px", "default": 900 },
    { "type": "range", "id": "desktop_padding_top", "label": "Top padding", "min": 0, "max": 150, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "desktop_padding_bottom", "label": "Bottom padding", "min": 0, "max": 150, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "desktop_heading_size", "label": "Heading size", "min": 16, "max": 56, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "desktop_heading_width", "label": "Heading max width", "min": 200, "max": 900, "step": 10, "unit": "px", "default": 700 },
    { "type": "range", "id": "desktop_heading_space", "label": "Space below heading", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
       { "type": "range", "id": "sh_gap", "label": "Space between heading and subheading", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "desktop_sh_size", "label": "Subheading size", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "desktop_sh_width", "label": "Subheading max width", "min": 200, "max": 900, "step": 10, "unit": "px", "default": 480 },
    { "type": "range", "id": "desktop_button_height", "label": "Button height", "min": 28, "max": 80, "step": 1, "unit": "px", "default": 34 },
    { "type": "range", "id": "desktop_button_padding", "label": "Button text side padding", "min": 8, "max": 60, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "desktop_button_font_size", "label": "Button text size", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "desktop_sub_size", "label": "Second line size", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "desktop_sub_space", "label": "Space above second line", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 26 },

    { "type": "header", "content": "Mobile layout" },
    { "type": "checkbox", "id": "mobile_button_full", "label": "Full width button", "default": true },
    { "type": "range", "id": "mobile_padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "mobile_heading_size", "label": "Heading size", "min": 16, "max": 44, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "mobile_heading_width", "label": "Heading max width", "min": 200, "max": 600, "step": 10, "unit": "px", "default": 300 },
    { "type": "range", "id": "mobile_heading_space", "label": "Space below heading", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 22 },
       { "type": "range", "id": "mobile_sh_size", "label": "Subheading size", "min": 8, "max": 20, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "mobile_button_height", "label": "Button height", "min": 32, "max": 80, "step": 1, "unit": "px", "default": 44 },
    { "type": "range", "id": "mobile_button_font_size", "label": "Button text size", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "mobile_sub_size", "label": "Second line size", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "mobile_sub_space", "label": "Space above second line", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 24 }
  ],
  "presets": [
    { "name": "Anfrage CTA" }
  ]
}
{% endschema %}