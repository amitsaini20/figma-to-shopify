{% comment %} 
{% comment %}
  Atelier hero section
  Image content and the CTA panel use separate layout areas.
  Desktop and mobile settings are managed independently.
{% endcomment %}

<section
  id="Hero-{{ section.id }}"
  class="atelier-hero"
  style="
    --hero-height-desktop: {{ section.settings.desktop_height }}px;
    --hero-height-mobile: {{ section.settings.mobile_height }}px;
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-heading-size: {{ section.settings.heading_size }}px;
    --hero-heading-size-mobile: {{ section.settings.mobile_heading_size }}px;
    --hero-copy-size: {{ section.settings.copy_size }}px;
    --hero-copy-size-mobile: {{ section.settings.mobile_copy_size }}px;
    --hero-content-width: {{ section.settings.content_width }}px;
    --hero-content-width-mobile: {{ section.settings.mobile_content_width }}px;
    --hero-content-x: {{ section.settings.content_position_x }}%;
    --hero-content-y: {{ section.settings.content_position_y }}%;
    --hero-content-x-mobile: {{ section.settings.mobile_content_position_x }}%;
    --hero-content-y-mobile: {{ section.settings.mobile_content_position_y }}%;
    --hero-text-color: {{ section.settings.text_color }};
    --hero-background-color: {{ section.settings.background_color }};
    --hero-button-color: {{ section.settings.button_color }};
    --hero-button-text-color: {{ section.settings.button_text_color }};
    --hero-panel-padding-top: {{ section.settings.panel_padding_top }}px;
    --hero-panel-padding-bottom: {{ section.settings.panel_padding_bottom }}px;
    --hero-panel-padding-x: {{ section.settings.panel_padding_x }}px;
    --hero-panel-mobile-padding-top: {{ section.settings.mobile_panel_padding_top }}px;
    --hero-panel-mobile-padding-bottom: {{ section.settings.mobile_panel_padding_bottom }}px;
    --hero-panel-mobile-padding-x: {{ section.settings.mobile_panel_padding_x }}px;
  "
>
  <div class="atelier-hero__visual">
    <div class="atelier-hero__media">
      {% if section.settings.desktop_image != blank %}
        <picture>
          {% if section.settings.mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ section.settings.mobile_image | image_url: width: 480 }} 480w,
                {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
                {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w
              "
            >
          {% endif %}

          {{
            section.settings.desktop_image
            | image_url: width: 2400
            | image_tag:
              widths: '750, 1100, 1500, 1800, 2200, 2400',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              class: 'atelier-hero__image',
              alt: section.settings.desktop_image.alt
          }}
        </picture>
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'atelier-hero__placeholder' }}
      {% endif %}
    </div>

    {% if section.settings.show_overlay %}
      <div class="atelier-hero__overlay" aria-hidden="true"></div>
    {% endif %}

    <div class="atelier-hero__image-content">
      {% if section.settings.eyebrow != blank %}
        <p class="atelier-hero__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="atelier-hero__heading">
          {{ section.settings.heading | escape | newline_to_br }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="atelier-hero__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="atelier-hero__panel">
    <div class="atelier-hero__actions">
      {% if section.settings.button_label != blank %}
        <a
          class="atelier-hero__button"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          {% if section.settings.show_button_arrow %}
            <span class="atelier-hero__button-arrow" aria-hidden="true">
              →
            </span>
          {% endif %}

          <span>{{ section.settings.button_label | escape }}</span>
        </a>
      {% endif %}

      {% if section.settings.secondary_label != blank %}
        <a
          class="atelier-hero__secondary"
          {% if section.settings.secondary_link != blank %}
            href="{{ section.settings.secondary_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          {% if section.settings.show_secondary_arrow %}
            <span aria-hidden="true">→</span>
          {% endif %}

          <span>{{ section.settings.secondary_label | escape }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #Hero-{{ section.id }} {
    width: 100%;
    color: var(--hero-text-color);
    background: var(--hero-background-color);
  }

  #Hero-{{ section.id }} .atelier-hero__visual {
    position: relative;
    isolation: isolate;
    height: var(--hero-height-desktop);
    overflow: hidden;
    background: #55504b;
  }

  #Hero-{{ section.id }} .atelier-hero__media,
  #Hero-{{ section.id }} .atelier-hero__media picture {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  #Hero-{{ section.id }} .atelier-hero__image,
  #Hero-{{ section.id }} .atelier-hero__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.desktop_image_position }};
  }

  #Hero-{{ section.id }} .atelier-hero__overlay {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: var(--hero-overlay-opacity);
    pointer-events: none;
  }

  #Hero-{{ section.id }} .atelier-hero__image-content {
    position: absolute;
    z-index: 1;
    top: var(--hero-content-y);
    left: calc(5.5% + var(--hero-content-x));
    width: min(var(--hero-content-width), 89%);
    transform: translateY(-0%);
    color: var(--hero-text-color);
  }

  #Hero-{{ section.id }} .atelier-hero__eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  #Hero-{{ section.id }} .atelier-hero__heading {
    max-width: 900px;
    margin: 0 0 16px;
    color: inherit;
    font-family: {{ section.settings.heading_font }};
    font-size: var(--hero-heading-size);
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.04;
    letter-spacing: -.025em;
  }

  #Hero-{{ section.id }} .atelier-hero__description {
    max-width: {{ section.settings.description_width }}px;
    color: inherit;
    font-size: var(--hero-copy-size);
    line-height: 1.65;
  }

  #Hero-{{ section.id }} .atelier-hero__description p {
    margin: 0;
  }

  /* Separate grey panel below the image */
  #Hero-{{ section.id }} .atelier-hero__panel {
    display: flex;
    align-items: center;
    min-height: {{ section.settings.panel_min_height }}px;
    padding:
      var(--hero-panel-padding-top)
      var(--hero-panel-padding-x)
      var(--hero-panel-padding-bottom);
    color: var(--hero-text-color);
    background: var(--hero-background-color);
  }

  #Hero-{{ section.id }} .atelier-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    width: 100%;
    margin: 0;
    padding-left: 5.5%;
  }

  #Hero-{{ section.id }} .atelier-hero__button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: {{ section.settings.button_height }}px;
    padding: 0 20px 0 8px;
    color: var(--hero-button-text-color);
    background: var(--hero-button-color);
    font-size: 12px;
    letter-spacing: .06em;
    text-decoration: none;
    transition: opacity .2s ease;
  }

  #Hero-{{ section.id }} .atelier-hero__button:hover {
    opacity: .85;
  }

  #Hero-{{ section.id }} .atelier-hero__button-arrow {
    display: grid;
    flex: 0 0 30px;
    place-items: center;
    width: 30px;
    height: 30px;
    background: rgb(255 255 255 / 13%);
    font-size: 16px;
  }

  #Hero-{{ section.id }} .atelier-hero__secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    font-size: 12px;
    letter-spacing: .04em;
    text-decoration: none;
  }

  #Hero-{{ section.id }} .atelier-hero__secondary:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    #Hero-{{ section.id }} .atelier-hero__visual {
      height: var(--hero-height-mobile);
    }

    #Hero-{{ section.id }} .atelier-hero__image {
      object-position: {{ section.settings.mobile_image_position }};
    }

    #Hero-{{ section.id }} .atelier-hero__image-content {
      top: var(--hero-content-y-mobile);
      left: calc(5% + var(--hero-content-x-mobile));
      width: min(var(--hero-content-width-mobile), 90%);
    }

    #Hero-{{ section.id }} .atelier-hero__eyebrow {
      margin-bottom: 8px;
      font-size: 10px;
    }

    #Hero-{{ section.id }} .atelier-hero__heading {
      margin-bottom: 12px;
      font-size: var(--hero-heading-size-mobile);
      line-height: 1.04;
    }

    #Hero-{{ section.id }} .atelier-hero__description {
      max-width: 100%;
      font-size: var(--hero-copy-size-mobile);
      line-height: 1.55;
    }

    #Hero-{{ section.id }} .atelier-hero__panel {
      min-height: {{ section.settings.mobile_panel_min_height }}px;
      padding:
        var(--hero-panel-mobile-padding-top)
        var(--hero-panel-mobile-padding-x)
        var(--hero-panel-mobile-padding-bottom);
    }

    #Hero-{{ section.id }} .atelier-hero__actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
      padding-left: 0;
    }

    #Hero-{{ section.id }} .atelier-hero__button {
      width: {{ section.settings.mobile_button_width }}%;
      min-height: {{ section.settings.mobile_button_height }}px;
      font-size: 10px;
    }

    #Hero-{{ section.id }} .atelier-hero__secondary {
      font-size: 10px;
    }
  }
</style>

{% schema %}
{
