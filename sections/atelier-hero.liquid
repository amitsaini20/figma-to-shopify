{% comment %}
  Atelier Hero
  Desktop: image with overlapping heading and description.
  Mobile: image first, heading overlapping image, description and CTA below.
{% endcomment %}

<section
  id="Hero-{{ section.id }}"
  class="atelier-hero"
  style="
    --hero-height-desktop: {{ section.settings.desktop_height }}px;
    --hero-height-mobile: {{ section.settings.mobile_height }}px;
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-heading-size: {{ section.settings.heading_size }}px;
    --hero-heading-size-mobile: {{ section.settings.mobile_heading_size }}px;
    --hero-copy-size: {{ section.settings.copy_size }}px;
    --hero-copy-size-mobile: {{ section.settings.mobile_copy_size }}px;
    --hero-content-width: {{ section.settings.content_width }}px;
    --hero-content-width-mobile: {{ section.settings.mobile_content_width }}px;
    --hero-text-color: {{ section.settings.text_color }};
    --hero-panel-color: {{ section.settings.background_color }};
    --hero-button-color: {{ section.settings.button_color }};
    --hero-button-text-color: {{ section.settings.button_text_color }};
    --hero-overlap: {{ section.settings.content_overlap }}px;
    --hero-overlap-mobile: {{ section.settings.mobile_content_overlap }}px;
  "
>
  <!-- HERO IMAGE -->
  <div class="atelier-hero__image-area">
    {% if section.settings.desktop_image != blank %}
      <picture class="atelier-hero__picture">
        {% if section.settings.mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
              {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w,
              {{ section.settings.mobile_image | image_url: width: 1500 }} 1500w
            "
          >
        {% endif %}

        {{
          section.settings.desktop_image
          | image_url: width: 3000
          | image_tag:
            widths: '750, 1100, 1500, 1800, 2200, 2600, 3000',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'atelier-hero__image',
            alt: section.settings.desktop_image.alt
        }}
      </picture>
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'atelier-hero__placeholder' }}
    {% endif %}

    {% if section.settings.show_overlay %}
      <div class="atelier-hero__overlay" aria-hidden="true"></div>
    {% endif %}

    <!-- DESKTOP TEXT OVER IMAGE -->
    <div class="atelier-hero__content atelier-hero__content--desktop">
      {% if section.settings.eyebrow != blank %}
        <p class="atelier-hero__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="atelier-hero__heading">
          {{ section.settings.heading | escape | newline_to_br }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="atelier-hero__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>

  <!-- LOWER BACKGROUND PANEL -->
  <div class="atelier-hero__background-area">

    <!-- MOBILE HEADING OVERLAPS IMAGE -->
    <div class="atelier-hero__content atelier-hero__content--mobile">
      {% if section.settings.eyebrow != blank %}
        <p class="atelier-hero__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="atelier-hero__heading">
          {{ section.settings.heading | escape | newline_to_br }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="atelier-hero__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    <!-- BUTTONS -->
    {% if section.settings.button_label != blank or section.settings.secondary_label != blank %}
      <div class="atelier-hero__actions">

        {% if section.settings.button_label != blank %}
          <a
            class="atelier-hero__button"
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            {% if section.settings.show_button_arrow %}
              <span class="atelier-hero__button-arrow" aria-hidden="true">→</span>
            {% endif %}

            <span>{{ section.settings.button_label | escape }}</span>
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank %}
          <a
            class="atelier-hero__secondary"
            {% if section.settings.secondary_link != blank %}
              href="{{ section.settings.secondary_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            {% if section.settings.show_secondary_arrow %}
              <span aria-hidden="true">→</span>
            {% endif %}

            <span>{{ section.settings.secondary_label | escape }}</span>
          </a>
        {% endif %}

      </div>
    {% endif %}

  </div>
</section>

<style>
  #Hero-{{ section.id }} {
    position: relative;
    isolation: isolate;
    width: 100%;
    margin: 0;
    padding: 0;
    color: var(--hero-text-color);
    background: var(--hero-panel-color);
    overflow: clip;
  }

  #Hero-{{ section.id }} *,
  #Hero-{{ section.id }} *::before,
  #Hero-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /* IMAGE AREA */

  #Hero-{{ section.id }} .atelier-hero__image-area {
    position: relative;
    width: 100%;
    {% comment %} height: var(--hero-height-desktop); {% endcomment %}
     height: 100%;
    {% comment %} overflow: hidden; {% endcomment %}
     z-index: 999;
   
  }

  #Hero-{{ section.id }} .atelier-hero__picture {
    {% comment %} position: absolute; {% endcomment %}
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  #Hero-{{ section.id }} .atelier-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.desktop_image_position }};
  }

  #Hero-{{ section.id }} .atelier-hero__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* IMAGE OVERLAY */

  #Hero-{{ section.id }} .atelier-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: {{ section.settings.overlay_color }};
    opacity: var(--hero-overlay-opacity);
    pointer-events: none;
  }

  /* DESKTOP TEXT ON IMAGE */

  #Hero-{{ section.id }} .atelier-hero__content--desktop {
    position: absolute;
    z-index: 2;
    left: 10.5%;
    bottom: -20px;
    width: min(var(--hero-content-width), 78%);
    padding-bottom: 0;
    transform: translateY(0);
    color: var(--hero-text-color);
  }

  #Hero-{{ section.id }} .atelier-hero__content--mobile {
    display: none;
  }

  #Hero-{{ section.id }} .atelier-hero__eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #Hero-{{ section.id }} .atelier-hero__heading {
    max-width: 900px;
    margin: 0 0 20px;
    color: inherit;
    font-size: var(--hero-heading-size);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  #Hero-{{ section.id }} .atelier-hero__description {
    max-width: {{ section.settings.description_width }}px;
    color: inherit;
    font-size: var(--hero-copy-size);
    line-height: 1.6;
  }

  #Hero-{{ section.id }} .atelier-hero__description p {
    margin: 0;
  }

  /* TAUPE BACKGROUND BELOW IMAGE */

  #Hero-{{ section.id }} .atelier-hero__background-area {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    min-height: {{ section.settings.panel_min_height }}px;
    padding: 48px 10.5% 42px;
    background: var(--hero-panel-color);
    color: var(--hero-text-color);
  }

  /* BUTTON ROW */

  #Hero-{{ section.id }} .atelier-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 28px;
    width: 100%;
    margin-top: 0;
  }

  #Hero-{{ section.id }} .atelier-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    min-height: {{ section.settings.button_height }}px;
    padding: 0 22px 0 8px;
    color: var(--hero-button-text-color);
    background: var(--hero-button-color);
    font-size: 12px;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  #Hero-{{ section.id }} .atelier-hero__button:hover {
    opacity: 0.85;
  }

  #Hero-{{ section.id }} .atelier-hero__button-arrow {
    display: grid;
    flex: 0 0 34px;
    place-items: center;
    width: 34px;
    height: 34px;
    background: rgb(255 255 255 / 13%);
    font-size: 16px;
  }

  #Hero-{{ section.id }} .atelier-hero__secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--hero-text-color);
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 1.5;
    text-decoration: none;
  }

  #Hero-{{ section.id }} .atelier-hero__secondary:hover {
    text-decoration: underline;
  }

  /* MOBILE */

  @media screen and (max-width: 749px) {
    #Hero-{{ section.id }} {
      overflow: hidden;
    }

    #Hero-{{ section.id }} .atelier-hero__image-area {
      height: var(--hero-height-mobile);
    }

    #Hero-{{ section.id }} .atelier-hero__image {
      object-position: {{ section.settings.mobile_image_position }};
    }

    #Hero-{{ section.id }} .atelier-hero__content--desktop {
      display: block;
      left: 4%;
      bottom: 0px;
    }
    #Hero-{{ section.id }} .atelier-hero__content--desktop .atelier-hero__description{
     display: none;
    }
    

    #Hero-{{ section.id }} .atelier-hero__background-area {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding: 0 5% 28px;
    }

    /* Pull heading upward over the bottom of the image.
       Description stays inside the colored panel. */

    #Hero-{{ section.id }} .atelier-hero__content--mobile {
      display: block;
      position: relative;
      z-index: 3;
      width: min(var(--hero-content-width-mobile), 100%);
      margin-top: calc(-1 * var(--hero-overlap-mobile));
      padding-top: 0;
      color: var(--hero-text-color);
    }

    #Hero-{{ section.id }} .atelier-hero__eyebrow {
      margin-bottom: 8px;
      font-size: 10px;
    }

    #Hero-{{ section.id }} .atelier-hero__heading {
      margin: 0 0 22px;
      font-size: var(--hero-heading-size-mobile);
      font-weight: 400;
      line-height: 1.08;
      letter-spacing: -0.02em;
    }

    #Hero-{{ section.id }} .atelier-hero__description {
      max-width: 100%;
      font-size: var(--hero-copy-size-mobile);
      line-height: 1.55;
    }

    #Hero-{{ section.id }} .atelier-hero__actions {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      width: 100%;
      margin-top: {{ section.settings.mobile_actions_spacing }}px;
    }

    #Hero-{{ section.id }} .atelier-hero__button {
      width: {{ section.settings.mobile_button_width }}%;
      max-width: 100%;
      min-height: {{ section.settings.mobile_button_height }}px;
      padding-right: 12px;
      font-size: 10px;
    }

    #Hero-{{ section.id }} .atelier-hero__button-arrow {
      flex-basis: 34px;
      width: 34px;
      height: 34px;
    }

    #Hero-{{ section.id }} .atelier-hero__secondary {
      font-size: 10px;
      display: none;
    }
  }

  /* SMALL PHONES */

  @media screen and (max-width: 380px) {
    #Hero-{{ section.id }} .atelier-hero__heading {
      font-size: min(var(--hero-heading-size-mobile), 30px);
    }

    #Hero-{{ section.id }} .atelier-hero__background-area {
      padding-right: 5%;
      padding-bottom: 24px;
      padding-left: 5%;
    }

    #Hero-{{ section.id }} .atelier-hero__actions {
      gap: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Atelier hero",
  "tag": "section",
  "class": "section-atelier-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Ihr persönliches Unikat.\nGefertigt nach Maß."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Stellen Sie sich Ihr Wunschprodukt zusammen – Sie entscheiden frei über Gestell, Maße und Naturstein. Handgefertigt in unserer Manufaktur in Sachsen-Anhalt.</p>"
    },
    {
      "type": "range",
      "id": "description_width",
      "label": "Description max width",
      "min": 250,
      "max": 900,
      "step": 25,
      "unit": "px",
      "default": 550
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image sizing",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Fill area (may crop edges)"
        },
        {
          "value": "contain",
          "label": "Show entire image"
        },
        {
          "value": "fill",
          "label": "Stretch to fill"
        }
      ]
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Desktop image position",
      "default": "center center",
      "options": [
        { "value": "left top", "label": "Top left" },
        { "value": "center top", "label": "Top center" },
        { "value": "right top", "label": "Top right" },
        { "value": "left center", "label": "Center left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Center right" },
        { "value": "left bottom", "label": "Bottom left" },
        { "value": "center bottom", "label": "Bottom center" },
        { "value": "right bottom", "label": "Bottom right" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "default": "center center",
      "options": [
        { "value": "left top", "label": "Top left" },
        { "value": "center top", "label": "Top center" },
        { "value": "right top", "label": "Top right" },
        { "value": "left center", "label": "Center left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Center right" },
        { "value": "left bottom", "label": "Bottom left" },
        { "value": "center bottom", "label": "Bottom center" },
        { "value": "right bottom", "label": "Bottom right" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show image overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#211F1C"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Unverbindliche Anfrage stellen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_button_arrow",
      "label": "Show button arrow",
      "default": true
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "Desktop button height",
      "min": 36,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 46
    },
    {
      "type": "range",
      "id": "mobile_button_height",
      "label": "Mobile button height",
      "min": 34,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "mobile_button_width",
      "label": "Mobile button width",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
