      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Magna Steps Slider",
      "blocks": [
        { "type": "slide", "settings": { "title": "01 - Anfrage senden", "text": "Sie beschreiben Ihre Wunschvorstellung: Maße, Gestell, Form – per Formular, WhatsApp oder vor Ort." } },
        { "type": "slide", "settings": { "title": "02 - Unverbindliches Angebot", "text": "Innerhalb von 48 Stunden erhalten Sie Ihr persönliches Angebot inklusive Lieferzeit." } },
