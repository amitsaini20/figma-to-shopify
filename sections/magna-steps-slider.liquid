    ]},
    { "type": "range", "id": "media_gap", "label": "Gap below image", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 14 },

    { "type": "header", "content": "Text" },
    { "type": "range", "id": "title_size", "label": "Slide title size - desktop", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "m_title_size", "label": "Slide title size - mobile", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "desc_size", "label": "Description size - desktop", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "m_desc_size", "label": "Description size - mobile", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 13 },

    { "type": "header", "content": "Arrows" },
    { "type": "checkbox", "id": "show_arrows_desktop", "label": "Show arrows on desktop", "default": false },
    { "type": "checkbox", "id": "show_arrows_mobile", "label": "Show arrow on mobile", "default": true },
    { "type": "range", "id": "arrow_size", "label": "Arrow size", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 44 },
   { "type": "range", "id": "arrow_top", "label": "Arrow vertical position - desktop", "min": 20, "max": 420, "step": 5, "unit": "px", "default": 135 },
    { "type": "range", "id": "m_arrow_top", "label": "Arrow vertical position - mobile", "min": 20, "max": 420, "step": 5, "unit": "px", "default": 90 },
    { "type": "color", "id": "arrow_bg", "label": "Arrow background", "default": "#ffffff" },
    { "type": "color", "id": "arrow_color", "label": "Arrow icon color", "default": "#1f1f1f" },

    { "type": "header", "content": "Colors" },
